# Copiar a backend/.env y completar. NUNCA subir el .env real a git
# (Norma 11, Seguridad por Diseño — 000-Constitucion/11-Seguridad.md).
# DATABASE_URL, DATABASE_URL_MIGRACIONES y REDIS_URL los arma
# docker-compose.yml a partir del .env de la raíz (ver ../.env.example).

APP_NAME=MERCHLY AI Backend
APP_VERSION=0.2.0
# local | test | staging | production
ENVIRONMENT=local

# OBLIGATORIO: el backend no arranca con un secreto de menos de 32
# caracteres o de ejemplo. Generar con:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Cifrado de secretos guardados en la base (verificación en dos pasos, tokens de WhatsApp).
# OBLIGATORIA en producción; en tu PC, si falta, se deriva del JWT. Generar con:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CIFRADO_CLAVE=

# Orígenes permitidos por CORS, separados por coma (nunca "*").
CORS_ORIGENES=http://localhost:3000

# true solo en tu PC si querés ver /docs (prohibido en staging/producción).
EXPONER_DOCS=false

# Client ID OAuth de Google para "Continuar con Google" (vacío = deshabilitado).
GOOGLE_CLIENT_ID=

# Gemini (Agente Investigador). Vacío = proveedor simulado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Agente de Marketing). Vacío = proveedor simulado.
# Poné un tope de gasto mensual en el panel de OpenAI ANTES de cargarla.
OPENAI_API_KEY=

# Modelo de IA según el plan de la organización (mejor plan = mejor modelo).
# Verificá los disponibles con: docker compose exec backend python -m scripts.probar_ia
MODELO_INVESTIGADOR_BETA=gemini-2.5-flash-lite
MODELO_INVESTIGADOR_EMPRENDEDOR=gemini-2.5-flash
MODELO_INVESTIGADOR_NEGOCIO=gemini-2.5-pro
MODELO_MARKETING_BETA=gpt-5-nano
MODELO_MARKETING_EMPRENDEDOR=gpt-5-mini
MODELO_MARKETING_NEGOCIO=gpt-5
IA_TIMEOUT_SEGUNDOS=45

# Emails (recuperar contraseña). Vacío = simulado en el log SOLO en local.
RESEND_API_KEY=
EMAIL_REMITENTE=MERCHLY AI <no-responder@merchly.ai>
# URL pública del frontend (para armar los links de los emails).
APP_URL=http://localhost:3000
