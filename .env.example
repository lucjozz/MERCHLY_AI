# Copiar a ".env" (misma carpeta que docker-compose.yml) y completar.
# NUNCA subir el .env real a git (Norma 11).
# Generar cada valor con:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"

# Superusuario de Postgres: SOLO para migraciones y administración.
# Ojo: cambiarlo en un volumen existente requiere también
#   ALTER USER merchly WITH PASSWORD '...';
POSTGRES_PASSWORD=

# Rol de la aplicación (merchly_app, sin privilegios de dueño, sujeto a RLS).
# Lo crea/actualiza la migración 202611230001.
DB_APP_PASSWORD=

# Redis con requirepass.
REDIS_PASSWORD=

# Clave de cifrado de backups (32 bytes en base64). Generar con:
#   backend/venv/Scripts/python.exe ops/backups/backup.py --generar-clave
# Guardala TAMBIÉN en un gestor de contraseñas: sin ella no se recupera ningún backup.
BACKUP_KEY=
